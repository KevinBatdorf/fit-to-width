{
	"name": "fit-to-width",
	"version": "0.1.0",
	"type": "module",
	"description": "A text block where each line is full width.",
	"author": "Kevin Batdorf",
	"license": "GPL-2.0-or-later",
	"main": "build/index.js",
	"scripts": {
		"build": "tsc && biome check && wp-scripts build",
		"check": "biome check --write",
		"format": "biome format --write .",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"start": "wp-scripts start",
		"test:e2e": "node scripts/run-e2e.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@playwright/test": "^1.62.1",
		"@types/wordpress__block-editor": "^15.0.6",
		"@wordpress/e2e-test-utils-playwright": "^1.52.0",
		"@wordpress/scripts": "^34.0.0",
		"@wp-playground/cli": "^3.1.48",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@wordpress/block-editor": "^16.1.0",
		"@wordpress/blocks": "^15.25.0",
		"@wordpress/components": "^38.0.0",
		"@wordpress/data": "^10.52.0",
		"@wordpress/element": "^8.4.0",
		"@wordpress/i18n": "^6.25.0"
	}
}
